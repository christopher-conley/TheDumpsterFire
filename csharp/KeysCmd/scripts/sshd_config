#### KeysCmd install note

#### You should probably edit the "AllowGroups" directive on line 60.
#### Members of the groups listed below will be able to login to this server via SSH:
#### 
####     PLACEHOLDERVALUECHANGEDBYINSTALLSCRIPT
#### 
#### These groups were dynamically chosen based on the environment that
#### the install script was run in. If you want to change/restrict/grant
#### access to different groups, you should edit line 60 to suit your needs.
#### 
#### PAY ATTENTION TO THE COMMENT ABOVE THE "AllowGroups" DIRECTIVE, IT'S IMPORTANT.
####
#### If you have trouble connecting after installation, try commenting the following lines
#### at the bottom of this config file and restarting the "ssh-agent" and "sshd" services:
####
####     Match Group administrators
####        AuthorizedKeysFile __PROGRAMDATA__/ssh/administrators_authorized_keys
####
#### This file is located at: C:\ProgramData\ssh\sshd_config

# This is the sshd server system-wide configuration file.  See
# sshd_config(5) for more information.

# The strategy used for options in the default sshd_config shipped with
# OpenSSH is to specify options with their default value where
# possible, but leave them commented.  Uncommented options override the
# default value.

Port 22
AddressFamily any
ListenAddress 0.0.0.0
ListenAddress ::

HostKey __PROGRAMDATA__/ssh/ssh_host_rsa_key
HostKey __PROGRAMDATA__/ssh/ssh_host_ecdsa_key
HostKey __PROGRAMDATA__/ssh/ssh_host_ed25519_key

# Ciphers and keying
#RekeyLimit default none

# Logging
SyslogFacility LOCAL0
LogLevel DEBUG1
#LogLevel INFO

# Authentication:

#LoginGraceTime 2m
#PermitRootLogin prohibit-password
#PermitRootLogin yes
#StrictModes yes
#MaxAuthTries 6
#MaxSessions 10

# Groups listed in the "AllowGroups" line below should be separated by a space and surrounded with double quotes
# THEY MUST ALSO BE ALL LOWERCASE. ENSURE THAT ALL CHARACTERS IN THE GROUP NAMES ARE LOWERCASE. Example:
# AllowGroups "somedomain\somesecuritygroup" "someotherdomain\someothersecuritygroup" "alocalgroup"

AllowGroups PLACEHOLDERVALUECHANGEDBYINSTALLSCRIPT
PubkeyAuthentication yes

# The default is to check both .ssh/authorized_keys and .ssh/authorized_keys2
# but this is overridden so installations will only check .ssh/authorized_keys
AuthorizedKeysFile	.ssh/authorized_keys

AuthorizedKeysCommand "C:\ProgramData\keyscmd\KeysCmd.exe" keys get -o -u "%u"
AuthorizedKeysCommandUser "system"

#AuthorizedPrincipalsFile none

# For this to work you will also need host keys in %programData%/ssh/ssh_known_hosts
#HostbasedAuthentication no
# Change to yes if you don't trust ~/.ssh/known_hosts for
# HostbasedAuthentication
#IgnoreUserKnownHosts no
# Don't read the user's ~/.rhosts and ~/.shosts files
#IgnoreRhosts yes

# To disable tunneled clear text passwords, change to no here!
#### Don't turn this on. Yes, I mean you.
#### There is no scenario where this needs to be enabled. Keep scrolling.
PasswordAuthentication no
#PermitEmptyPasswords no

# GSSAPI options
GSSAPIAuthentication no

AllowAgentForwarding yes
#AllowTcpForwarding yes
#GatewayPorts no
#PermitTTY yes
#PrintMotd yes
#PrintLastLog yes
TCPKeepAlive yes
#PermitUserEnvironment no
#Compression delayed
#ClientAliveInterval 0
#ClientAliveCountMax 3
#UseDNS no
#MaxStartups 10:30:100
#PermitTunnel no
#ChrootDirectory none
#VersionAddendum none

# no default banner path
#Banner none

# override default of no subsystems
Subsystem	sftp	sftp-server.exe

# Example of overriding settings on a per-user basis
#Match User anoncvs
#	AllowTcpForwarding no
#	PermitTTY no
#	ForceCommand cvs server

HostKeyAlgorithms=ssh-rsa,ssh-rsa-cert-v01@openssh.com,ecdsa-sha2-nistp256,ecdsa-sha2-nistp256-cert-v01@openssh.com,ecdsa-sha2-nistp384,ecdsa-sha2-nistp384-cert-v01@openssh.com,ecdsa-sha2-nistp521,ecdsa-sha2-nistp521-cert-v01@openssh.com,ssh-ed25519,ssh-ed25519-cert-v01@openssh.com
PubkeyAcceptedAlgorithms=+ssh-rsa,ssh-rsa-cert-v01@openssh.com,ssh-rsa,ssh-rsa-cert-v01@openssh.com,ecdsa-sha2-nistp256,ecdsa-sha2-nistp256-cert-v01@openssh.com,ecdsa-sha2-nistp384,ecdsa-sha2-nistp384-cert-v01@openssh.com,ecdsa-sha2-nistp521,ecdsa-sha2-nistp521-cert-v01@openssh.com,ssh-ed25519,ssh-ed25519-cert-v01@openssh.com

Match Group administrators
       AuthorizedKeysFile __PROGRAMDATA__/ssh/administrators_authorized_keys
