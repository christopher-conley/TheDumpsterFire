<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RosettaTools.Text.EasyANSI</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- GenerateDocumentationFile>true</GenerateDocumentationFile> -->
    <AssemblyName>RosettaTools.Text.EasyANSI</AssemblyName>
    <AssemblyTitle>EasyANSI</AssemblyTitle>
    <AssemblyVersion>$([System.IO.File]::ReadAllText("VERSION").Trim())</AssemblyVersion>
    <Authors>Christohper Conley</Authors>
    <Company>Rosetta Stoned Software</Company>
    <Description>
      EasyANSI for PowerShell: Format console text using ANSI color and control codes with a stupid-simple
      markup scheme. Make important parts of your messages stand out, blink text like it's 1996, or just make
      rainbows because you can.
    </Description>
    <Copyright>Copyright (c) 2024 Christopher Conley</Copyright>
    <InformationalVersion>$(AssemblyVersion)</InformationalVersion>
    <IsPackable>true</IsPackable>
    <Product>EasyANSI</Product>
    <ProductName>EasyANSI</ProductName>
    <ProductVersion>$(AssemblyVersion)</ProductVersion>
    <Version>$(AssemblyVersion)</Version>
    <SignAssembly>True</SignAssembly>
    <DelaySign>True</DelaySign>
    <Title>RosettaTools.Text.EasyANSI</Title>
    <PackageProjectUrl>https://github.com/christopher-conley/EasyANSI</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/christopher-conley/EasyANSI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>color;text;ansi;console;utility</PackageTags>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <ProjectGuid>0945e509-fea9-dead-beef-b36cff6c5bf3</ProjectGuid>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\RosettaTools\csharp\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\RosettaTools\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="System.Management.Automation">
      <Version>7.2.24</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
    <PackageReference Include="System.Management.Automation">
      <Version>7.3.12</Version>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Management.Automation">
      <Version>7.4.6</Version>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="System.Management.Automation">
      <Version>7.5.1</Version>
    </PackageReference>
  </ItemGroup>

</Project>
