<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>doccmethod</Title>
      <Author>Christopher Conley</Author>
      <Description>Generates a skeleton XML &lt;summary&gt; documentation block for a class method</Description>
      <HelpUrl></HelpUrl>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Keywords>
        <Keyword></Keyword>
      </Keywords>
      <Shortcut>doccmethod</Shortcut>
    </Header>
    <Snippet>
      <References />
      <Imports />
      <Declarations />
      <Code Language="CSharp" Kind="any" Delimiter="$"><![CDATA[
/// <summary>
/// Method that goes to The Derek Zoolander Center for Kids Who Can't Read Good and Wanna Learn to Do Other Stuff Good Too
/// </summary>
/// <param name="SomeParameter">An instace of <see cref="SomeCSharpType"/> object used to do some stuff</param>
/// <returns><see cref="BlueSteel"/></returns>
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
