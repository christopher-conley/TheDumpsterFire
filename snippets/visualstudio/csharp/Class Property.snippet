<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>doccprop</Title>
      <Author>Christopher Conley</Author>
      <Description>Generates a skeleton XML &lt;summary&gt; documentation block for a class property</Description>
      <HelpUrl></HelpUrl>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Keywords>
        <Keyword></Keyword>
      </Keywords>
      <Shortcut>doccprop</Shortcut>
    </Header>
    <Snippet>
      <References />
      <Imports />
      <Declarations />
      <Code Language="CSharp" Kind="any" Delimiter="$"><![CDATA[
/// <summary>
/// Holds some class property that contains some info that does some stuff
/// <br></br><br>See also: <seealso cref="AssociatedClassVariable"/></br>
/// </summary>
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
