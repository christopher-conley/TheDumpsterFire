<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>docclass</Title>
      <Author>Christopher Conley</Author>
      <Description>Generates a skeleton XML &lt;summary&gt; documentation block for a class</Description>
      <HelpUrl></HelpUrl>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Keywords>
        <Keyword></Keyword>
      </Keywords>
      <Shortcut>docclass</Shortcut>
    </Header>
    <Snippet>
      <References />
      <Imports />
      <Declarations />
      <Code Language="CSharp" Kind="any" Delimiter="$"><![CDATA[
/// <summary>
/// Class that goes to The Derek Zoolander Center for Kids Who Can't Read Good and Wanna Learn to Do Other Stuff Good Too
/// <br></br>
/// <br>Contains the following methods:</br>
/// <list type="bullet">
/// <item><see cref="SomeMethodName" /></item>
/// <item><see cref="SomeOtherMethodName" /></item>
/// <item><see cref="BlueSteel" /></item>
/// <item><see cref="YetAnotherMethod" /></item>
/// </list>
/// </summary>
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
